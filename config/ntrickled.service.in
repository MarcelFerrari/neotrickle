[Unit]
Description=ntrickle bandwidth limiter daemon (trickled)
Documentation=https://github.com/MarcelFerrari/neotrickle
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/trickled

# The daemon removes stale sockets itself after acquiring its singleton lock.
# Do not pre-delete socket or lock files here: doing so can bypass the lock of
# a live daemon that was not started by this unit.

RuntimeDirectory=ntrickle
RuntimeDirectoryPreserve=yes

Restart=on-failure
RestartSec=5

LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
